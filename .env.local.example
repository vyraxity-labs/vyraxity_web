# Canonical site URL (used for metadata, canonical URLs, OG tags, and sitemap generation)
# In development: http://localhost:3000
# In production: https://vyraxity.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional Email Delivery (Resend) — Introduced in Phase 10
# Get your API key from https://resend.com/api-keys
# RESEND_API_KEY=re_your_api_key_here

# The recipient inbox for contact form submissions
# CONTACT_TO_EMAIL=hello@vyraxity.com

# The verified sending domain email address in Resend
# CONTACT_FROM_EMAIL=no-reply@vyraxity.com
